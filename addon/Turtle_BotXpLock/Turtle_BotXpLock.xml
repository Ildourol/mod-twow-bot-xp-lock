                </Anchors>
                <Scripts>
                    <OnClick>TurtleBotXpLock_OnRateClick(0.5)</OnClick>
                </Scripts>
            </Button>

            <Button name="Turtle_BotXpLock_Rate1" inherits="UIPanelButtonTemplate" text="1.0x">
