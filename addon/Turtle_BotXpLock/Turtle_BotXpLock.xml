                </Anchors>
                <Scripts>
                    <OnClick>TurtleBotXpLock_OnRateClick(2.0)</OnClick>
                </Scripts>
            </Button>

            <Button name="Turtle_BotXpLock_Rate3" inherits="UIPanelButtonTemplate" text="3.0x">
                <Size><AbsDimension x="54" y="22"/></Size>
                <Anchors>
                    <Anchor point="LEFT" relativeTo="Turtle_BotXpLock_Rate2" relativePoint="RIGHT"><Offset><AbsDimension x="7" y="0"/></Offset></Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>TurtleBotXpLock_OnRateClick(3.0)</OnClick>
                </Scripts>
            </Button>

            <!-- Twink Bracket Quick-Cap Buttons (19, 29, 39, 49, 59) -->
            <Button name="Turtle_BotXpLock_Cap19" inherits="UIPanelButtonTemplate" text="Cap 19" id="19">
                <Size><AbsDimension x="54" y="22"/></Size>
                <Anchors>
                    <Anchor point="TOPLEFT"><Offset><AbsDimension x="20" y="-240"/></Offset></Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>TurtleBotXpLock_OnCapClick(19)</OnClick>
                </Scripts>
            </Button>

            <Button name="Turtle_BotXpLock_Cap29" inherits="UIPanelButtonTemplate" text="Cap 29" id="29">
                <Size><AbsDimension x="54" y="22"/></Size>
                <Anchors>
                    <Anchor point="LEFT" relativeTo="Turtle_BotXpLock_Cap19" relativePoint="RIGHT"><Offset><AbsDimension x="7" y="0"/></Offset></Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>TurtleBotXpLock_OnCapClick(29)</OnClick>
                </Scripts>
            </Button>

            <Button name="Turtle_BotXpLock_Cap39" inherits="UIPanelButtonTemplate" text="Cap 39" id="39">
                <Size><AbsDimension x="54" y="22"/></Size>
                <Anchors>
                    <Anchor point="LEFT" relativeTo="Turtle_BotXpLock_Cap29" relativePoint="RIGHT"><Offset><AbsDimension x="7" y="0"/></Offset></Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>TurtleBotXpLock_OnCapClick(39)</OnClick>
                </Scripts>
            </Button>

            <Button name="Turtle_BotXpLock_Cap49" inherits="UIPanelButtonTemplate" text="Cap 49" id="49">
                <Size><AbsDimension x="54" y="22"/></Size>
                <Anchors>
                    <Anchor point="LEFT" relativeTo="Turtle_BotXpLock_Cap39" relativePoint="RIGHT"><Offset><AbsDimension x="7" y="0"/></Offset></Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>TurtleBotXpLock_OnCapClick(49)</OnClick>
                </Scripts>
            </Button>

            <Button name="Turtle_BotXpLock_Cap59" inherits="UIPanelButtonTemplate" text="Cap 59" id="59">
                <Size><AbsDimension x="54" y="22"/></Size>
                <Anchors>
                    <Anchor point="LEFT" relativeTo="Turtle_BotXpLock_Cap49" relativePoint="RIGHT"><Offset><AbsDimension x="7" y="0"/></Offset></Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>TurtleBotXpLock_OnCapClick(59)</OnClick>
                </Scripts>
            </Button>

            <!-- Custom Cap Input Box & Set Button -->
            <EditBox name="Turtle_BotXpLock_CustomCapBox" autoFocus="false" inherits="InputBoxTemplate" numeric="true">
                <Size><AbsDimension x="50" y="22"/></Size>
                <Anchors>
                    <Anchor point="TOPLEFT"><Offset><AbsDimension x="25" y="-270"/></Offset></Anchor>
                </Anchors>
                <Scripts>
                    <OnEscapePressed>this:ClearFocus()</OnEscapePressed>
                    <OnEnterPressed>TurtleBotXpLock_OnCustomCapSet()</OnEnterPressed>
                </Scripts>
            </EditBox>
            <Button name="Turtle_BotXpLock_CustomCapButton" inherits="UIPanelButtonTemplate" text="Set Custom Cap">
                <Size><AbsDimension x="120" y="22"/></Size>
                <Anchors>
                    <Anchor point="LEFT" relativeTo="Turtle_BotXpLock_CustomCapBox" relativePoint="RIGHT"><Offset><AbsDimension x="10" y="0"/></Offset></Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>TurtleBotXpLock_OnCustomCapSet()</OnClick>
                </Scripts>
            </Button>

            <!-- Party Roster Rows 1..4 (Shifted down) -->
            <Frame name="Turtle_BotXpLock_PartyRow1" inherits="TurtleBotXpLockPartyRowTemplate" id="1">
                <Anchors>
                    <Anchor point="TOPLEFT"><Offset><AbsDimension x="20" y="-330"/></Offset></Anchor>
                </Anchors>
            </Frame>
            <Frame name="Turtle_BotXpLock_PartyRow2" inherits="TurtleBotXpLockPartyRowTemplate" id="2">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="Turtle_BotXpLock_PartyRow1" relativePoint="BOTTOMLEFT"><Offset><AbsDimension x="0" y="-4"/></Offset></Anchor>
                </Anchors>
            </Frame>
            <Frame name="Turtle_BotXpLock_PartyRow3" inherits="TurtleBotXpLockPartyRowTemplate" id="3">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="Turtle_BotXpLock_PartyRow2" relativePoint="BOTTOMLEFT"><Offset><AbsDimension x="0" y="-4"/></Offset></Anchor>
                </Anchors>
            </Frame>
            <Frame name="Turtle_BotXpLock_PartyRow4" inherits="TurtleBotXpLockPartyRowTemplate" id="4">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="Turtle_BotXpLock_PartyRow3" relativePoint="BOTTOMLEFT"><Offset><AbsDimension x="0" y="-4"/></Offset></Anchor>
                </Anchors>
            </Frame>

            <!-- Toggle All Configured Bots Registry Button -->
            <Button name="Turtle_BotXpLock_ToggleRegistryButton" inherits="UIPanelButtonTemplate" text="All Configured Bots >>">
                <Size><AbsDimension x="170" y="22"/></Size>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="Turtle_BotXpLock_PartyRow4" relativePoint="BOTTOMLEFT"><Offset><AbsDimension x="0" y="-12"/></Offset></Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>
                        TurtleBotXpLock_ToggleRegistry()
                    </OnClick>
                </Scripts>
            </Button>

            <!-- Refresh / Sync Button -->
            <Button name="Turtle_BotXpLock_RefreshButton" inherits="UIPanelButtonTemplate" text="Refresh">
                <Size><AbsDimension x="80" y="22"/></Size>
                <Anchors>
                    <Anchor point="BOTTOMLEFT"><Offset><AbsDimension x="20" y="16"/></Offset></Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>
                        TurtleBotXpLock_Refresh()
                    </OnClick>
                </Scripts>
            </Button>

            <!-- Done Button -->
            <Button name="Turtle_BotXpLock_DoneButton" inherits="UIPanelButtonTemplate" text="Close">
                <Size><AbsDimension x="80" y="22"/></Size>
                <Anchors>
                    <Anchor point="BOTTOMRIGHT"><Offset><AbsDimension x="-20" y="16"/></Offset></Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>
                        HideUIPanel(this:GetParent())
                    </OnClick>
                </Scripts>
            </Button>
        </Frames>

        <Scripts>
            <OnLoad>
                this:SetBackdropColor(0.06, 0.07, 0.09, 0.94)
                TurtleBotXpLock_OnLoad()
            </OnLoad>
            <OnMouseDown>
                this:StartMoving()
            </OnMouseDown>
            <OnMouseUp>
                this:StopMovingOrSizing()
            </OnMouseUp>
        </Scripts>
    </Frame>

    <!-- Side Registry Frame (All Bots with Custom XP Locks / Rates) -->
    <Frame name="Turtle_BotXpLock_RegistryFrame" toplevel="true" movable="false" enableMouse="true" hidden="true" parent="Turtle_BotXpLockFrame">
