                </Anchors>
                <Scripts>
                    <OnClick>TurtleBotXpLock_OnRateClick(1.0)</OnClick>
                </Scripts>
            </Button>

            <Button name="Turtle_BotXpLock_Rate2" inherits="UIPanelButtonTemplate" text="2.0x">
                <Size><AbsDimension x="54" y="22"/></Size>
                <Anchors>
