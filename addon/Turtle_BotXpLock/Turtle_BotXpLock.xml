<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">

    <!-- Party Member Bot Row Template (300 x 26) -->
    <Frame name="TurtleBotXpLockPartyRowTemplate" virtual="true">
        <Size><AbsDimension x="300" y="26"/></Size>
        <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
            <EdgeSize><AbsValue val="8"/></EdgeSize>
            <TileSize><AbsValue val="8"/></TileSize>
            <BackgroundInsets><AbsInset left="2" right="2" top="2" bottom="2"/></BackgroundInsets>
        </Backdrop>
        <Layers>
            <Layer level="ARTWORK">
                <Texture name="$parentClassIcon">
                    <Size><AbsDimension x="18" y="18"/></Size>
                    <Anchors>
                        <Anchor point="LEFT"><Offset><AbsDimension x="4" y="0"/></Offset></Anchor>
                    </Anchors>
                </Texture>
                <FontString name="$parentName" inherits="GameFontNormalSmall" justifyH="LEFT" text="">
                    <Size><AbsDimension x="110" y="16"/></Size>
                    <Anchors>
                        <Anchor point="LEFT" relativeTo="$parentClassIcon" relativePoint="RIGHT">
                            <Offset><AbsDimension x="4" y="0"/></Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
                <FontString name="$parentStatus" inherits="GameFontHighlightSmall" justifyH="CENTER" text="">
                    <Size><AbsDimension x="70" y="16"/></Size>
                    <Anchors>
                        <Anchor point="LEFT" relativeTo="$parentName" relativePoint="RIGHT">
                            <Offset><AbsDimension x="2" y="0"/></Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Button name="$parentToggleBtn" inherits="UIPanelButtonTemplate" text="Toggle">
                <Size><AbsDimension x="60" y="18"/></Size>
                <Anchors>
                    <Anchor point="RIGHT"><Offset><AbsDimension x="-4" y="0"/></Offset></Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>
                        TurtleBotXpLock_OnPartyRowToggle(this:GetParent():GetID())
                    </OnClick>
                </Scripts>
            </Button>
        </Frames>
        <Scripts>
            <OnLoad>
                this:SetBackdropColor(0.08, 0.08, 0.10, 0.75)
            </OnLoad>
        </Scripts>
    </Frame>

    <!-- Registry Bot Row Template (340 x 26) -->
    <Frame name="TurtleBotXpLockRegistryRowTemplate" virtual="true">
        <Size><AbsDimension x="340" y="26"/></Size>
        <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
            <EdgeSize><AbsValue val="8"/></EdgeSize>
            <TileSize><AbsValue val="8"/></TileSize>
            <BackgroundInsets><AbsInset left="2" right="2" top="2" bottom="2"/></BackgroundInsets>
        </Backdrop>
        <Layers>
            <Layer level="ARTWORK">
                <FontString name="$parentName" inherits="GameFontNormalSmall" justifyH="LEFT" text="">
                    <Size><AbsDimension x="110" y="16"/></Size>
                    <Anchors>
                        <Anchor point="LEFT"><Offset><AbsDimension x="8" y="0"/></Offset></Anchor>
                    </Anchors>
                </FontString>
                <FontString name="$parentLevel" inherits="GameFontHighlightSmall" justifyH="CENTER" text="">
                    <Size><AbsDimension x="45" y="16"/></Size>
                    <Anchors>
                        <Anchor point="LEFT" relativeTo="$parentName" relativePoint="RIGHT"><Offset><AbsDimension x="2" y="0"/></Offset></Anchor>
                    </Anchors>
                </FontString>
                <FontString name="$parentStatus" inherits="GameFontHighlightSmall" justifyH="CENTER" text="">
                    <Size><AbsDimension x="95" y="16"/></Size>
                    <Anchors>
                        <Anchor point="LEFT" relativeTo="$parentLevel" relativePoint="RIGHT"><Offset><AbsDimension x="2" y="0"/></Offset></Anchor>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Button name="$parentTargetBtn" inherits="UIPanelButtonTemplate" text="Select">
                <Size><AbsDimension x="55" y="18"/></Size>
                <Anchors>
                    <Anchor point="RIGHT"><Offset><AbsDimension x="-6" y="0"/></Offset></Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>
                        TurtleBotXpLock_OnRegistryRowSelect(this:GetParent():GetID())
                    </OnClick>
                </Scripts>
            </Button>
        </Frames>
        <Scripts>
            <OnLoad>
                this:SetBackdropColor(0.08, 0.08, 0.12, 0.70)
            </OnLoad>
        </Scripts>
    </Frame>

    <!-- Main Controller Frame -->
    <Frame name="Turtle_BotXpLockFrame" toplevel="true" movable="true" enableMouse="true" hidden="true" parent="UIParent">
        <Size><AbsDimension x="340" y="575"/></Size>
        <Anchors>
            <Anchor point="CENTER"><Offset><AbsDimension x="0" y="20"/></Offset></Anchor>
        </Anchors>
        <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background" edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
            <EdgeSize><AbsValue val="32"/></EdgeSize>
            <TileSize><AbsValue val="32"/></TileSize>
            <BackgroundInsets><AbsInset left="11" right="12" top="12" bottom="11"/></BackgroundInsets>
        </Backdrop>

        <Layers>
            <Layer level="ARTWORK">
                <!-- Title Texture & Header -->
                <Texture name="Turtle_BotXpLockHeader" file="Interface\DialogFrame\UI-DialogBox-Header">
                    <Size><AbsDimension x="256" y="64"/></Size>
                    <Anchors>
                        <Anchor point="TOP"><Offset><AbsDimension x="0" y="12"/></Offset></Anchor>
                    </Anchors>
                </Texture>
                <FontString name="Turtle_BotXpLockTitle" inherits="GameFontNormal" text="Bot XP Controller">
                    <Anchors>
                        <Anchor point="TOP" relativeTo="Turtle_BotXpLockHeader">
                            <Offset><AbsDimension x="0" y="-14"/></Offset>
                        </Anchor>
                    </Anchors>
                </FontString>

                <!-- Target Section Header -->
                <FontString name="Turtle_BotXpLock_TargetHeader" inherits="GameFontHighlightSmall" text="CURRENT TARGET BOT:" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="TOPLEFT"><Offset><AbsDimension x="20" y="-36"/></Offset></Anchor>
                    </Anchors>
                </FontString>

                <!-- Target Bot Name & Level -->
                <FontString name="Turtle_BotXpLock_TargetName" inherits="GameFontNormalLarge" text="No Target" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="TOPLEFT"><Offset><AbsDimension x="20" y="-52"/></Offset></Anchor>
                    </Anchors>
                </FontString>
                <FontString name="Turtle_BotXpLock_TargetInfo" inherits="GameFontHighlightSmall" text="Select a companion or friendly bot" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="TOPLEFT"><Offset><AbsDimension x="20" y="-72"/></Offset></Anchor>
                    </Anchors>
                </FontString>

                <!-- XP Rate Section Header -->
                <FontString name="Turtle_BotXpLock_RateHeader" inherits="GameFontNormalSmall" text="Individual XP Rate Multiplier:" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="TOPLEFT"><Offset><AbsDimension x="20" y="-160"/></Offset></Anchor>
                    </Anchors>
                </FontString>

                <!-- Twink Bracket Cap Header -->
                <FontString name="Turtle_BotXpLock_CapHeader" inherits="GameFontNormalSmall" text="Quick Twink Bracket Caps:" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="TOPLEFT"><Offset><AbsDimension x="20" y="-220"/></Offset></Anchor>
                    </Anchors>
                </FontString>

                <!-- Party Roster Section Header (Moved down to give generous space below custom cap) -->
                <FontString name="Turtle_BotXpLock_RosterHeader" inherits="GameFontNormalSmall" text="Party Companion Roster:" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="TOPLEFT"><Offset><AbsDimension x="20" y="-308"/></Offset></Anchor>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>

        <Frames>
            <!-- Close Button -->
            <Button name="Turtle_BotXpLockCloseButton" inherits="UIPanelCloseButton">
                <Anchors>
                    <Anchor point="TOPRIGHT"><Offset><AbsDimension x="-5" y="-5"/></Offset></Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>
                        HideUIPanel(this:GetParent())
                    </OnClick>
                </Scripts>
            </Button>

            <!-- Status Badge Box -->
            <Frame name="Turtle_BotXpLock_StatusBadge">
                <Size><AbsDimension x="300" y="30"/></Size>
                <Anchors>
                    <Anchor point="TOPLEFT"><Offset><AbsDimension x="20" y="-92"/></Offset></Anchor>
                </Anchors>
                <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
                    <EdgeSize><AbsValue val="10"/></EdgeSize>
                    <TileSize><AbsValue val="10"/></TileSize>
                    <BackgroundInsets><AbsInset left="2" right="2" top="2" bottom="2"/></BackgroundInsets>
                </Backdrop>
                <Layers>
                    <Layer level="ARTWORK">
                        <FontString name="Turtle_BotXpLock_StatusText" inherits="GameFontNormal" text="XP STATUS: UNKNOWN" justifyH="CENTER">
                            <Anchors>
                                <Anchor point="CENTER"><Offset><AbsDimension x="0" y="0"/></Offset></Anchor>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
                <Scripts>
                    <OnLoad>
                        this:SetBackdropColor(0.12, 0.12, 0.15, 0.85)
                    </OnLoad>
                </Scripts>
            </Frame>

            <!-- Action Buttons for Target -->
            <Button name="Turtle_BotXpLock_FreezeButton" inherits="UIPanelButtonTemplate" text="Freeze XP (0x / Lock)">
                <Size><AbsDimension x="145" y="24"/></Size>
                <Anchors>
                    <Anchor point="TOPLEFT"><Offset><AbsDimension x="20" y="-128"/></Offset></Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>
                        TurtleBotXpLock_OnFreezeClick()
                    </OnClick>
                </Scripts>
            </Button>

            <Button name="Turtle_BotXpLock_UnlockButton" inherits="UIPanelButtonTemplate" text="Unlock XP (1.0x)">
                <Size><AbsDimension x="145" y="24"/></Size>
                <Anchors>
                    <Anchor point="TOPRIGHT"><Offset><AbsDimension x="-20" y="-128"/></Offset></Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>
                        TurtleBotXpLock_OnUnlockClick()
                    </OnClick>
                </Scripts>
            </Button>

            <!-- Individual XP Rate Multipliers (0.25x, 0.5x, 1x, 2x, 3x) -->
            <Button name="Turtle_BotXpLock_Rate025" inherits="UIPanelButtonTemplate" text="0.25x">
                <Size><AbsDimension x="54" y="22"/></Size>
                <Anchors>
                    <Anchor point="TOPLEFT"><Offset><AbsDimension x="20" y="-180"/></Offset></Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>TurtleBotXpLock_OnRateClick(0.25)</OnClick>
                </Scripts>
            </Button>

            <Button name="Turtle_BotXpLock_Rate05" inherits="UIPanelButtonTemplate" text="0.5x">
